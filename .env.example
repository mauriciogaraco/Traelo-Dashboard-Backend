# Servidor
NODE_ENV=development
PORT=3000

# Base de datos
# Local: DATABASE_URL="postgresql://user:password@localhost:5432/traelo_operaciones?schema=public"
# Supabase (recomendado: Session pooler, IPv4 — la conexión directa es IPv6-only):
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Bootstrap (usado por prisma/seed.ts para crear el primer OWNER)
SEED_OWNER_EMAIL="owner@traelo.com"
SEED_OWNER_PASSWORD="ChangeMe123!"

# App móvil (Fase 2): API key simple que valida que la request viene de la app oficial.
# NO identifica a un cliente ni reemplaza autenticación real — es solo una barrera básica
# anti-scraping para las rutas públicas de catálogo. Opcional: sin configurar, esas rutas
# responden 403 en vez de tumbar el arranque del servidor.
MOBILE_APP_API_KEY="change-me-mobile-app-api-key"

# Telegram (Fase 14): notificación operacional al grupo/canal cuando se crea un pedido de la
# app/web (no de pedidos manuales del dashboard, ni la fuente de verdad del pedido — eso
# siempre es Postgres). Opcional: sin configurar, simplemente no se envían notificaciones.
TELEGRAM_BOT_TOKEN="change-me-telegram-bot-token"
TELEGRAM_CHAT_ID="change-me-telegram-chat-id"

# Cloudinary (imágenes de productos/negocios — ver Product.imageUrl/Business.logoUrl).
# CLOUDINARY_CLOUD_NAME todavía falta configurar (no es secreto, pero hace falta para armar
# la URL de la API — está en el dashboard de Cloudinary, "Cloud name").
CLOUDINARY_CLOUD_NAME="change-me-cloudinary-cloud-name"
CLOUDINARY_API_KEY="change-me-cloudinary-api-key"
CLOUDINARY_API_SECRET="change-me-cloudinary-api-secret"
