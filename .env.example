# Servidor
NODE_ENV=development
PORT=3000

# Base de datos
# Local: DATABASE_URL="postgresql://user:password@localhost:5432/traelo_operaciones?schema=public"
# Supabase (recomendado: Session pooler, IPv4 — la conexión directa es IPv6-only):
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Bootstrap (usado por prisma/seed.ts para crear el primer OWNER)
SEED_OWNER_EMAIL="owner@traelo.com"
SEED_OWNER_PASSWORD="ChangeMe123!"
