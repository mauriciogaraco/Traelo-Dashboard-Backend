generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
  DELIVERER
  // Dueño/a de un negocio (no de Tráelo): accede solo a los datos de SU negocio, ligado por
  // User.businessId. Nunca ve ganancias de Tráelo (platformFee, comisión, reparto de mensajería).
  BUSINESS_OWNER
}

enum CommissionType {
  PERCENTAGE
  FIXED_PER_PRODUCT
}

enum SubscriptionCycle {
  DAYS_7
  DAYS_15
  DAYS_21
  DAYS_30
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ASSIGNED
  // Fase app mensajero: el mensajero acepta el pedido asignado ("Por confirmar" -> ASSIGNED)
  // y lo confirma explícitamente antes de completarlo. Distinto de simplemente estar ASSIGNED:
  // separa "me lo asignaron" de "ya lo tengo, voy en camino".
  CONFIRMED
  // Sub-fases del trayecto, entre confirmar y completar — el mensajero las avanza una por una
  // desde la app (secuencial, sin saltos): va camino al negocio, está recogiendo el pedido en
  // el negocio, y ya va con el pedido hacia el cliente. Staff puede saltárselas igual que ya
  // podía saltarse CONFIRMED (ver ordersService.STAFF_STATUS_TRANSITIONS).
  HEADING_OUT
  PICKING_UP
  ON_THE_WAY
  COMPLETED
  CANCELLED
}

enum SettlementType {
  DAILY
  WEEKLY
}

enum SettlementStatus {
  OPEN
  CLOSED
}

enum BusinessSettlementStatus {
  PENDING
  PAID
}

// Origen del pedido. Los pedidos históricos y los que siga registrando el
// dashboard quedan como MANUAL (default) — ese default preserva su semántica actual.
enum OrderSource {
  APP
  WEB
  MANUAL
  TELEGRAM
}

// Cómo se obtuvo la ubicación de una dirección. Solo MANUAL_PIN y DEVICE_LOCATION: si algún día
// el equipo corrige ubicaciones a mano se agrega un valor (ALTER TYPE ... ADD VALUE, sin romper nada).
enum LocationSource {
  MANUAL_PIN
  DEVICE_LOCATION
}

enum DevicePlatform {
  ANDROID
  IOS
}

// Tipo de entidad del catálogo afectada por un cambio, para la sincronización incremental
// de la app (ver CatalogChangeLog).
enum CatalogEntityType {
  BUSINESS
  PRODUCT
  CATEGORY
  BUSINESS_HOURS
  BUSINESS_CLOSURE
  PRODUCT_OFFER
}

enum CatalogChangeType {
  UPSERT
  DELETE
}

// ── Auth / Usuarios ──────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  role         Role
  active       Boolean   @default(true)
  // Solo se llena cuando role = BUSINESS_OWNER: el único negocio que esta cuenta administra.
  // Varias cuentas pueden apuntar al mismo negocio (dueño + socio).
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deliverer         Deliverer?
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  registeredOrders  Order[]              @relation("OrderRegisteredBy")
  closedSettlements Settlement[]         @relation("SettlementClosedBy")

  @@index([role])
  @@index([businessId])
  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Mensajeros ───────────────────────────────────────────

model Deliverer {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt             DateTime @default(now())
  commissionPercentage Decimal? @db.Decimal(5, 2)
  // Foto de perfil (solo la URL, nunca el binario). Opcional: la app la muestra al cliente junto al
  // nombre del mensajero cuando existe.
  photoUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Cola de despacho automático (app móvil): null = no está en línea, no recibe pedidos
  // nuevos. No-null = en línea, y el valor es la posición de turno — el pedido nuevo se le
  // ofrece al Deliverer en línea con el queuedAt más antiguo (el que lleva más tiempo
  // esperando), y al asignarle uno se le vuelve a poner queuedAt = ahora (pasa al final de la
  // cola). Activarse (null -> ahora) también deja a ese mensajero al final: su timestamp fresco
  // es, por construcción, posterior al de cualquiera que ya haya recibido un pedido antes.
  // Distinto de `user.active` (cuenta habilitada/dada de baja por el staff, administrativo).
  queuedAt DateTime?

  // "Reiniciar historial" (app móvil): fecha desde la que el mensajero quiere ver su propio
  // historial de entregados/cancelados. Es puramente de visualización — nunca borra ni oculta
  // pedidos para el staff/dashboard/cuadres, solo filtra la consulta cuando el que pregunta es
  // el propio DELIVERER (ver ordersService.listOrders, scopeDelivererId). null = sin filtrar,
  // ve todo su historial completo.
  historyResetAt DateTime?

  // Notificaciones push (app móvil): token de Expo Push del dispositivo donde el mensajero
  // tiene sesión iniciada. Un solo token por mensajero (un solo dispositivo activo a la vez,
  // igual supuesto que el resto de esta app) — se sobrescribe en cada login/registro, nunca se
  // acumula una lista. null = el mensajero nunca dio permiso de notificaciones, o cerró sesión
  // (ver AuthStore.logout en la app, que lo limpia). Ver src/shared/push.
  expoPushToken String?

  assignedOrders Order[]      @relation("OrderDeliverer")
  settlements    Settlement[]
  reviews        DelivererReview[]

  // Última ubicación conocida (seguimiento en vivo). Máximo una fila por mensajero.
  location DelivererLocation?

  @@map("deliverers")
}

// Última ubicación GPS conocida de un mensajero con entrega activa, para el seguimiento del
// pedido en la app del cliente. NO es un histórico: cada actualización pisa la fila anterior
// (upsert por delivererId) y la fila se borra cuando el mensajero se queda sin entregas activas.
// `updatedAt` lo fija el servidor — nunca un timestamp enviado por el dispositivo.
model DelivererLocation {
  id          String    @id @default(cuid())
  delivererId String    @unique
  deliverer   Deliverer @relation(fields: [delivererId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  accuracy    Float?
  updatedAt   DateTime  @updatedAt

  @@map("deliverer_locations")
}

// ── Clientes (app móvil) ──────────────────────────────────
// Independiente de `User`: User es exclusivamente el usuario interno del dashboard
// (OWNER/ADMIN/EMPLOYEE/DELIVERER). Customer es quien compra desde la app/web.
// Cuenta OPCIONAL: comprar nunca exige tener un Customer (los pedidos de invitado tienen
// Order.customerId = null y conservan sus snapshots). El teléfono es el identificador
// principal; passwordHash es null mientras no haya una cuenta con contraseña.

model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  email         String?
  // null = sin credenciales (registro heredado o cuenta aún sin contraseña).
  passwordHash  String?
  // Reservados para una futura verificación por OTP/enlace. Hoy NUNCA se ponen en true: no hay
  // canal de SMS/email aprobado, y escribir un teléfono no lo verifica.
  phoneVerified Boolean   @default(false)
  emailVerified Boolean   @default(false)
  // Saldo de puntos de fidelización = suma de sus PointsTransaction (se mantiene en la misma
  // transacción que cada movimiento). Entero, nunca decimal.
  pointsBalance Int       @default(0)
  active        Boolean   @default(true)
  lastOrderAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses          CustomerAddress[]
  devices            CustomerDevice[]
  orders             Order[]
  favoriteBusinesses CustomerFavoriteBusiness[]
  favoriteProducts   CustomerFavoriteProduct[]
  refreshTokens      CustomerRefreshToken[]
  passwordResets     CustomerPasswordResetToken[]
  pointsTransactions PointsTransaction[]
  delivererReviews   DelivererReview[]
  businessReviews    BusinessReview[]

  @@map("customers")
}

// Sesión persistente del cliente. Tablas propias (no se reutilizan las de User): un cliente
// nunca comparte espacio de tokens con el personal interno.
model CustomerRefreshToken {
  id                  String    @id @default(cuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

// Recuperación de contraseña: solo se guarda el hash, expira y es de un solo uso.
model CustomerPasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@map("customer_password_reset_tokens")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  address    String
  reference  String?
  isDefault  Boolean  @default(false)

  // Ubicación EXACTA opcional (pin que el cliente colocó a mano). La dirección escrita sigue
  // siendo lo obligatorio; sin coordenadas todo funciona igual, solo sin mapa. Ambas o ninguna.
  latitude         Float?
  longitude        Float?
  locationSource   LocationSource?
  locationAccuracy Float? // metros; solo si vino del GPS del dispositivo

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Nota: Order.customerAddress / Order.addressReference son snapshots históricos
  // del pedido y NO se actualizan cuando el cliente edita o borra una dirección aquí.
  @@index([customerId])
  @@map("customer_addresses")
}

// Preparado para push notifications; sin lógica de Firebase/APNs todavía.
model CustomerDevice {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String?
  appVersion String?
  active     Boolean        @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([customerId])
  @@map("customer_devices")
}

model CustomerFavoriteBusiness {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, businessId])
  @@index([customerId])
  @@map("customer_favorite_businesses")
}

model CustomerFavoriteProduct {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("customer_favorite_products")
}

// ── Negocios / Catálogo ──────────────────────────────────

model Business {
  id                             String         @id @default(cuid())
  name                           String
  phone                          String
  address                        String
  joinedAt                       DateTime       @default(now())
  active                         Boolean        @default(true)
  // active = el negocio pertenece a Tráelo. acceptingOrders = puede recibir pedidos ahora mismo
  // (independiente de active). El horario/BusinessClosure determina además si está abierto.
  acceptingOrders                Boolean        @default(true)
  commissionType                 CommissionType
  commissionPercentage           Decimal?       @db.Decimal(5, 2)
  defaultProductCommissionAmount Decimal?       @db.Decimal(10, 2)
  // Tarifa base de mensajería para pedidos creados desde la app (CUP). Default 250; los
  // negocios con mensajería más cara (ej. DLM, Ella y Yo, La Lomita, Los Reales, Las
  // Palmitas) se configuran en 350 desde el dashboard. El cálculo final (recargo nocturno,
  // recargo por negocio extra en pedidos multi-negocio) vive en
  // orders/delivery-fee-calculator.ts, no acá — esto es solo la tarifa base por negocio.
  deliveryFeeBase                Decimal        @default(250) @db.Decimal(10, 2)
  // Fase 22: mismo criterio que Product.imageUrl — solo la URL, versionada al servirla.
  logoUrl                        String?
  // Blurhash del logo (ver shared/blurhash): la app lo muestra como placeholder mientras carga la
  // imagen real. Se calcula al subir la imagen; si logoUrl se edita a mano queda en null.
  logoBlurhash                   String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  products            Product[]
  productCommissions  BusinessProductCommission[]
  subscriptions       BusinessSubscription[]
  orderBusinesses     OrderBusiness[]
  businessSettlements BusinessSettlement[]
  businessHours       BusinessHours[]
  closures            BusinessClosure[]
  favoritedBy         CustomerFavoriteBusiness[]
  ownerUsers          User[]
  reviews             BusinessReview[]

  @@index([active, acceptingOrders])
  @@map("businesses")
}

// Preparado para el flujo de liquidación a negocios. Todavía sin service/rutas:
// solo el modelo, listo para cuando se implemente el pago a negocios.
model BusinessSettlement {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  periodStart DateTime
  periodEnd   DateTime

  orderCount        Int     @default(0)
  grossSales        Decimal @default(0) @db.Decimal(12, 2) // ventas del negocio (subtotal), 100% suyo
  platformFeeEarned Decimal @default(0) @db.Decimal(12, 2) // Servicio Tráelo generado por este negocio

  status BusinessSettlementStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, periodStart, periodEnd])
  @@index([businessId, status])
  @@map("business_settlements")
}

model BusinessSubscription {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycle      SubscriptionCycle
  price      Decimal            @db.Decimal(10, 2)
  startDate  DateTime
  endDate    DateTime
  status     SubscriptionStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())

  @@index([businessId, status])
  @@map("business_subscriptions")
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Legacy: string libre, se mantiene por compatibilidad con productos existentes.
  // Nueva navegación estructurada vía categoryId/categoryRef (ver Category). No se elimina
  // todavía: primero hay que poblar Category y hacer el backfill de categoryId.
  category    String?
  categoryId  String?
  price       Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  // active = pertenece al catálogo. available = tiene stock/está ofreciéndose ahora mismo.
  // active=true + available=false = "existe en el catálogo pero está agotado".
  available   Boolean  @default(true)
  // Independiente de available: el producto SÍ se puede comprar, pero se le avisa al cliente
  // que queda poco (para que no se lleve una sorpresa si se agota antes de que le respondan
  // el pedido). No reemplaza available — cuando de verdad se agota, available pasa a false.
  lowStock    Boolean  @default(false)
  externalId  String?
  // Fase 22 del checklist de la app: solo la URL, nunca el binario. Quien la aloja es
  // responsable de que sea cacheable agresivamente; el catálogo la sirve con un query param
  // de versión (?v=updatedAt) para que un cambio de imagen invalide el cache del móvil sin
  // depender de que la URL en sí cambie.
  imageUrl    String?
  // Mismo criterio que Business.logoBlurhash.
  imageBlurhash String?
  // Opciones de empaque/envase entre las que el cliente elige al comprar (ej. Termopack, Caja,
  // Jaba): [{ name, price, capacity? }]. null = el producto no lleva empaque. `price` es el costo
  // del empaque en CUP; `capacity`, si existe, son las unidades que caben en un empaque (sin ella
  // se cobra un empaque por unidad). Se valida con packagingSchema (businesses/packaging.ts).
  packaging     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Nombrado categoryRef (no category) porque el campo legacy `category` ya ocupa ese
  // nombre. Cuando se retire el string legacy, este relation field puede renombrarse a
  // `category` sin tocar la columna categoryId (los relation fields no son columnas).
  categoryRef Category?                  @relation(fields: [categoryId], references: [id])
  commission  BusinessProductCommission?
  orderItems  OrderItem[]
  offers      ProductOffer[]
  favoritedBy CustomerFavoriteProduct[]
  rewards     Reward[]

  @@unique([businessId, externalId])
  @@index([businessId, active, available])
  @@index([categoryId])
  @@map("products")
}

model BusinessProductCommission {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  commissionAmount Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("business_product_commissions")
}

// Categoría global de catálogo (no pertenece a un negocio en particular). Navegación y
// búsqueda de la app. Ver comentario en Product.category sobre la estrategia de transición
// desde el string legacy.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  // Mismo criterio que Product.imageUrl: solo la URL (Cloudinary), nunca el binario. Si no hay
  // imagen, la app cae a `icon`; si tampoco hay `icon`, muestra un ícono genérico.
  imageUrl      String?
  // Mismo criterio que Business.logoBlurhash. Se calcula al subir la imagen; si imageUrl se
  // edita a mano queda en null.
  imageBlurhash String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// Precio promocional temporal. NO reemplaza Product.price (precio normal/referencial):
// el precio efectivo de un pedido siempre queda congelado en OrderItem.unitPrice al momento
// de la compra. El cálculo de qué precio aplicar (normal vs. oferta vigente) es lógica de
// aplicación, fuera del alcance de esta tarea.
model ProductOffer {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([active, startsAt, endsAt])
  @@map("product_offers")
}

// Horario habitual semanal. Un cierre puntual (ej. mantenimiento de un día) se resuelve con
// BusinessClosure, no modificando este horario. Un solo turno por día (sin franjas partidas)
// — suficiente para el alcance actual, evita sobreingeniería.
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = domingo … 6 = sábado (convención JS Date#getDay())
  openTime   DateTime @db.Time()
  closeTime  DateTime @db.Time()
  closed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("business_hours")
}

// Cierre excepcional de un día puntual (mantenimiento, feriado, etc.) sin tocar el horario
// habitual en BusinessHours.
model BusinessClosure {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, date])
  @@index([businessId])
  @@map("business_closures")
}

// ── Pedidos ──────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  orderNumber      Int         @unique @default(autoincrement())
  customerName     String
  customerAddress  String
  addressReference String?
  // Coordenadas del destino (snapshot, como la dirección). Nullable: los pedidos existentes y
  // las direcciones que no se pudieron ubicar en el mapa no las tienen; el seguimiento
  // funciona igual, solo sin marcador de destino.
  destinationLatitude  Float?
  destinationLongitude Float?
  customerPhone    String
  deliveryFee      Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  // Todos los pedidos existentes fueron registrados manualmente por el equipo desde el
  // dashboard — MANUAL preserva exactamente ese comportamiento histórico.
  source           OrderSource @default(MANUAL)
  orderDate        DateTime    @default(now())
  assignedAt       DateTime?
  // Aceptar y confirmar son dos decisiones separadas del mensajero (app móvil): aceptar ("me lo
  // asigno a mí mismo") NO mueve `status` (sigue ASSIGNED), solo marca este campo; confirmar
  // (status: CONFIRMED) es un paso posterior y aparte, y el backend exige que acceptedAt ya esté
  // seteado para permitirlo (ver ordersService.acceptOrder / updateOrderStatus). Cuando el
  // ASIGNA es el staff (dashboard), acceptedAt se marca de una — ese pedido ya está aceptado, el
  // mensajero no puede declinarlo, solo le llega un aviso informativo (ver ordersService.assignOrder,
  // AssignOrderOptions.autoAccept). El accept/decline explícito solo aplica al despacho automático
  // por cola (dispatchToQueue), donde el mensajero sí decide.
  acceptedAt       DateTime?
  // Etapas del reparto mientras el pedido está ASSIGNED (el estado no cambia): el mensajero va por el
  // pedido (pickingUpAt) y ya lo lleva al cliente (onTheWayAt). null = todavía no. El cliente ve el
  // seguimiento en vivo a partir de pickingUpAt. Se siguen llenando (además del status
  // CONFIRMED/HEADING_OUT/PICKING_UP/ON_THE_WAY de la app móvil) para no romper el seguimiento en
  // vivo del cliente, que se dispara a partir de estos timestamps — ver ordersService.updateOrderStatus.
  pickingUpAt      DateTime?
  onTheWayAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  // Cliente de la app/web, si el pedido está vinculado a uno. Nullable: hay pedidos
  // manuales sin Customer y seguirá habiendo (empleado ↔ cliente desconocido/no registrado).
  // customerName/customerPhone/customerAddress/addressReference arriba son el snapshot
  // histórico del pedido y NUNCA cambian si el Customer edita sus datos después.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Idempotencia (Fase 13 del checklist de la app): la app manda un id generado en el
  // cliente por intento de checkout. Si la misma request llega dos veces (mala conexión,
  // timeout, doble tap), la segunda encuentra este unique y devuelve el pedido ya creado en
  // vez de duplicarlo. Nullable/único: los pedidos manuales del dashboard nunca lo usan.
  clientRequestId String? @unique

  // Pedidos de invitado (customerId = null): hash SHA-256 de un token aleatorio que se entrega
  // UNA sola vez, al crear el pedido, al dispositivo que lo hizo. Con él el invitado puede ver
  // el estado y valorar sin cuenta, sin depender de que "coincida el teléfono". Null en pedidos
  // de cliente autenticado y en los manuales.
  guestAccessTokenHash String? @unique

  delivererId String?
  deliverer   Deliverer? @relation("OrderDeliverer", fields: [delivererId], references: [id])

  // Nullable: un pedido creado por un Customer desde la app no tiene un User de staff detrás
  // (customerId = X, registeredByUserId = null). Los pedidos manuales del dashboard lo siguen
  // llenando siempre — ese flujo no cambia.
  registeredByUserId String?
  registeredBy       User?   @relation("OrderRegisteredBy", fields: [registeredByUserId], references: [id])

  productsTotal Decimal @db.Decimal(10, 2) // subtotal de productos — 100% del negocio, nunca se toca
  platformFee   Decimal @default(0) @db.Decimal(10, 2) // "Servicio Tráelo": suma de comisiones por negocio, redondeada hacia arriba al múltiplo de 10. 0 en pedidos previos a este cambio (nunca tuvieron un cargo separado).
  // Valor en CUP de lo cubierto con puntos (canje de una recompensa). 0 en pedidos sin canje.
  // productsTotal NO se reduce (el negocio cobra su producto completo); solo baja lo que paga el cliente.
  pointsDiscount Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2) // productsTotal - pointsDiscount + deliveryFee + platformFee

  // Número del "🎟️ Número del Sorteo" del vale, cuando el pedido participa de una promoción
  // vigente. Opcional: no todos los pedidos ni todas las épocas tienen sorteo activo.
  raffleNumber Int?

  traeloEarning       Decimal @db.Decimal(10, 2) // ganancia total de Tráelo = platformFee + traeloDeliveryShare
  delivererEarning    Decimal @db.Decimal(10, 2)
  traeloDeliveryShare Decimal @default(0) @db.Decimal(10, 2) // parte de Tráelo en la mensajería (deliveryFee - delivererEarning)

  businesses      OrderBusiness[]
  settlementLines SettlementOrderLine[]

  // Reseñas del cliente sobre este pedido (ver DelivererReview / BusinessReview).
  delivererReview DelivererReview?
  businessReviews BusinessReview[]

  pointsTransactions PointsTransaction[]
  redemption         RewardRedemption?

  // Recordatorio push de "tenés un pedido por aceptar/confirmar" (app móvil): cuándo se le
  // mandó al mensajero por este pedido puntual. null = todavía no se le mandó. El job periódico
  // (src/jobs/pending-order-reminders.ts) manda UN SOLO recordatorio por pedido en toda su vida
  // — nunca se repite, y nunca le quita el pedido a nadie (ver ordersService.assignOrder).
  lastReminderPushAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderDate])
  @@index([delivererId])
  @@index([customerId])
  @@map("orders")
}

model OrderBusiness {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessId       String
  business         Business @relation(fields: [businessId], references: [id])
  subtotal         Decimal  @db.Decimal(10, 2)
  commissionEarned Decimal  @db.Decimal(10, 2) // sin redondear — el detalle real generado por este negocio

  // Snapshots: si el negocio se renombra o cambia su modelo/porcentaje de comisión después,
  // este pedido histórico no debe cambiar. Nullable porque los pedidos creados antes de este
  // cambio nunca capturaron esta información (no se inventa un valor histórico falso).
  businessNameSnapshot   String?
  commissionTypeSnapshot CommissionType?
  commissionRateSnapshot Decimal?        @db.Decimal(5, 2) // solo aplica cuando commissionTypeSnapshot = PERCENTAGE

  items OrderItem[]

  // A lo sumo una reseña por (pedido, negocio) — ver BusinessReview.
  review BusinessReview?

  @@unique([orderId, businessId])
  @@index([businessId])
  @@map("order_businesses")
}

// ── Puntos de fidelización (V1) ──────────────────────────
// Libro mayor INMUTABLE: nunca se edita ni se borra una fila; las correcciones son movimientos
// nuevos (ORDER_ADJUSTMENT, firmados). Cada fila guarda la regla y el monto usados para poder
// auditar por qué se dio o se retiró cada punto.

enum PointsTransactionType {
  ORDER_COMPLETED
  ORDER_ADJUSTMENT
  // Bono único por el primer pedido completado desde la app/web (una vez por cliente).
  FIRST_ORDER_BONUS
  // Canje de una recompensa al crear el pedido (firmado, negativo).
  REDEMPTION
  // Devolución de un canje cuando el pedido se cancela o elimina (firmado, positivo).
  REDEMPTION_REFUND
}

model PointsTransaction {
  id           String                @id @default(cuid())
  customerId   String
  customer     Customer              @relation(fields: [customerId], references: [id])
  type         PointsTransactionType
  // Firmado y distinto de cero: positivo acredita, negativo retira.
  points       Int
  balanceAfter Int
  orderId      String?
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Snapshots: sobreviven aunque el pedido cambie después.
  orderNumber  Int?
  serviceFee   Decimal               @db.Decimal(10, 2)
  divisor      Int
  reason       String
  // Idempotencia del crédito inicial de un pedido ("order-earn:<orderId>"): imposible duplicarlo.
  dedupeKey    String?               @unique
  createdAt    DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
  @@map("points_transactions")
}

// ── Recompensas y canje (V1) ─────────────────────────────
// Una recompensa = "este producto se puede obtener con N puntos". No hay equivalencia fija
// puntos↔CUP: cada recompensa define su propio pointsCost. En V1 siempre apunta a un producto
// del catálogo (productId obligatorio); el modelo queda separado de Product para poder tener
// costos distintos, campañas o recompensas temporales sin tocar el catálogo.
model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  pointsCost  Int
  active      Boolean  @default(true)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]

  @@index([active])
  @@index([productId])
  @@map("rewards")
}

enum RedemptionStatus {
  APPLIED
  REFUNDED
}

// Un canje aplicado a un pedido. orderId es ÚNICO: una recompensa por pedido, garantizado por la
// base de datos. Guarda snapshots (nombre, costo, valor en CUP) para que el histórico no cambie
// si después cambia Reward.pointsCost o Product.price.
model RewardRedemption {
  id              String           @id @default(cuid())
  orderId         String           @unique
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String
  rewardId        String
  reward          Reward           @relation(fields: [rewardId], references: [id])
  productId       String
  rewardName      String
  pointsCost      Int
  moneyValue      Decimal          @db.Decimal(10, 2)
  status          RedemptionStatus @default(APPLIED)
  createdAt       DateTime         @default(now())
  refundedAt      DateTime?

  @@index([customerId, createdAt])
  @@index([rewardId])
  @@map("reward_redemptions")
}

// ── Reseñas ──────────────────────────────────────────────
// El pedido es la referencia histórica: no existe una reseña "global" de un negocio o de un
// mensajero, siempre nace de un pedido COMPLETED concreto. Dos modelos separados (en vez de
// uno genérico con targetType) para que las claves foráneas sean reales, la restricción
// anti-duplicado sea un @@unique simple y el promedio sea un aggregate directo.
//
// rating: Decimal(2,1) → 1.0 a 5.0 con un decimal (paso 0.1). El rango se refuerza además con
// un CHECK en la migración (Prisma no modela CHECK) y con validación zod en el API.
// customerId es null cuando el pedido fue de un invitado (se autoriza con guestAccessToken).

model DelivererReview {
  id          String    @id @default(cuid())
  // @unique: un pedido tiene un solo mensajero, así que una sola reseña de mensajero.
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  delivererId String
  deliverer   Deliverer @relation(fields: [delivererId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  rating      Decimal   @db.Decimal(2, 1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([delivererId])
  @@index([customerId])
  @@map("deliverer_reviews")
}

model BusinessReview {
  id         String @id @default(cuid())
  orderId    String
  businessId String
  // FK compuesta a OrderBusiness: la base de datos garantiza que el negocio valorado
  // realmente forma parte de ese pedido.
  orderBusiness OrderBusiness @relation(fields: [orderId, businessId], references: [orderId, businessId])
  order         Order         @relation(fields: [orderId], references: [id])
  business      Business      @relation(fields: [businessId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  rating        Decimal       @db.Decimal(2, 1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([orderId, businessId])
  @@index([businessId])
  @@index([customerId])
  @@map("business_reviews")
}

model OrderItem {
  id               String        @id @default(cuid())
  orderBusinessId  String
  orderBusiness    OrderBusiness @relation(fields: [orderBusinessId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id])
  productName      String
  quantity         Int           @default(1)
  unitPrice        Decimal       @db.Decimal(10, 2)
  subtotal         Decimal       @db.Decimal(10, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)
  // Canje: puntos usados y valor en CUP cubierto por UNA unidad de esta línea (0 = sin canje).
  // unitPrice conserva el precio original; el precio efectivo es subtotal - pointsDiscount.
  pointsRedeemed   Int           @default(0)
  pointsDiscount   Decimal       @default(0) @db.Decimal(10, 2)
  // Empaque elegido (snapshot: nombre y costo tal como estaban en Product.packaging al
  // comprar — si luego cambia el catálogo, este pedido no se altera). null = sin empaque.
  // packagingFee es 100% del negocio (como subtotal): NUNCA entra en la base de la comisión
  // de Tráelo (ver prepareBusinessGroups en orders.service.ts).
  packagingName    String?
  packagingFee     Decimal       @default(0) @db.Decimal(10, 2)

  @@index([productId])
  @@map("order_items")
}

// ── Cuadres ──────────────────────────────────────────────

model Settlement {
  id          String           @id @default(cuid())
  type        SettlementType
  delivererId String
  deliverer   Deliverer        @relation(fields: [delivererId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      SettlementStatus @default(OPEN)

  totalDeliveries      Int     @default(0)
  totalCollected       Decimal @default(0) @db.Decimal(10, 2)
  traeloDeliveryShare  Decimal @default(0) @db.Decimal(10, 2) // parte de Tráelo en la mensajería (antes "traeloShare")
  delivererShare       Decimal @default(0) @db.Decimal(10, 2)
  platformFeeCollected Decimal @default(0) @db.Decimal(10, 2) // Servicio Tráelo cobrado por contraentrega (antes "productCommissions")
  totalToDeliver       Decimal @default(0) @db.Decimal(10, 2)

  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?     @relation("SettlementClosedBy", fields: [closedByUserId], references: [id])

  orderLines SettlementOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([delivererId, type, periodStart, periodEnd])
  @@index([status])
  @@map("settlements")
}

model SettlementOrderLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])

  @@unique([settlementId, orderId])
  @@map("settlement_order_lines")
}

// ── Config global ────────────────────────────────────────

model SystemConfig {
  id                                   String  @id @default("singleton")
  defaultDelivererCommissionPercentage Decimal @default(60) @db.Decimal(5, 2)

  // Bloque promocional opcional que se agrega al final del vale generado (p.ej. campaña de
  // sorteo). rafflePromoText vacío/null = no agregar nada al vale, sin necesidad de un flag
  // "activo" aparte.
  rafflePromoText String?
  raffleVideoUrl  String?

  // Puntos V1: puntos = floor(Servicio Tráelo / pointsServiceDivisor). Solo cuentan los pedidos
  // completados desde pointsEnabledFrom (los anteriores no generan ni ajustan puntos).
  pointsServiceDivisor Int      @default(10)
  // Bono de bienvenida: puntos fijos por el primer pedido completado desde la app (0 = desactivado).
  pointsFirstOrderBonus Int     @default(10)
  pointsEnabledFrom    DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// Contador global del catálogo (fila única, mismo patrón que SystemConfig). La app móvil
// hace GET del valor actual al abrir y lo compara con el que tiene cacheado localmente para
// decidir si necesita sincronizar. La capa de servicio (fuera de esta tarea) es responsable
// de incrementarlo cada vez que cambie Business/Product/Category/precio/disponibilidad/
// horario/oferta/estado operativo.
model CatalogState {
  id        String   @id @default("singleton")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("catalog_state")
}

// Log mínimo para "GET changes since version X": una fila por entidad de catálogo que
// cambió, con la versión de CatalogState vigente en ese momento. La app pide
// WHERE version > X ORDER BY version y vuelve a pedir esas entidades por su endpoint normal
// — este log no duplica los datos de la entidad, solo señala qué cambió.
model CatalogChangeLog {
  id         String            @id @default(cuid())
  version    Int
  entityType CatalogEntityType
  entityId   String
  changeType CatalogChangeType @default(UPSERT)
  createdAt  DateTime          @default(now())

  @@index([version])
  @@index([entityType, entityId])
  @@map("catalog_change_log")
}
