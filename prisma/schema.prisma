generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
  DELIVERER
}

enum CommissionType {
  PERCENTAGE
  FIXED_PER_PRODUCT
}

enum SubscriptionCycle {
  DAYS_7
  DAYS_15
  DAYS_21
  DAYS_30
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum SettlementType {
  DAILY
  WEEKLY
}

enum SettlementStatus {
  OPEN
  CLOSED
}

enum BusinessSettlementStatus {
  PENDING
  PAID
}

// Origen del pedido. Los pedidos históricos y los que siga registrando el
// dashboard quedan como MANUAL (default) — ese default preserva su semántica actual.
enum OrderSource {
  APP
  WEB
  MANUAL
  TELEGRAM
}

enum DevicePlatform {
  ANDROID
  IOS
}

// Tipo de entidad del catálogo afectada por un cambio, para la sincronización incremental
// de la app (ver CatalogChangeLog).
enum CatalogEntityType {
  BUSINESS
  PRODUCT
  CATEGORY
  BUSINESS_HOURS
  BUSINESS_CLOSURE
  PRODUCT_OFFER
}

enum CatalogChangeType {
  UPSERT
  DELETE
}

// ── Auth / Usuarios ──────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliverer         Deliverer?
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  registeredOrders  Order[]              @relation("OrderRegisteredBy")
  closedSettlements Settlement[]         @relation("SettlementClosedBy")

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Mensajeros ───────────────────────────────────────────

model Deliverer {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt             DateTime @default(now())
  commissionPercentage Decimal? @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignedOrders Order[]      @relation("OrderDeliverer")
  settlements    Settlement[]

  @@map("deliverers")
}

// ── Clientes (app móvil) ──────────────────────────────────
// Independiente de `User`: User es exclusivamente el usuario interno del dashboard
// (OWNER/ADMIN/EMPLOYEE/DELIVERER). Customer es quien compra desde la app/web.
// Todavía sin passwordHash: la app usará un flujo propio (teléfono/OTP) que se
// diseñará en otra tarea. El teléfono es el identificador principal del cliente.

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String    @unique
  email       String?
  active      Boolean   @default(true)
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  addresses          CustomerAddress[]
  devices            CustomerDevice[]
  orders             Order[]
  favoriteBusinesses CustomerFavoriteBusiness[]
  favoriteProducts   CustomerFavoriteProduct[]

  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  address    String
  reference  String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Nota: Order.customerAddress / Order.addressReference son snapshots históricos
  // del pedido y NO se actualizan cuando el cliente edita o borra una dirección aquí.
  @@index([customerId])
  @@map("customer_addresses")
}

// Preparado para push notifications; sin lógica de Firebase/APNs todavía.
model CustomerDevice {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String?
  appVersion String?
  active     Boolean        @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([customerId])
  @@map("customer_devices")
}

model CustomerFavoriteBusiness {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, businessId])
  @@index([customerId])
  @@map("customer_favorite_businesses")
}

model CustomerFavoriteProduct {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("customer_favorite_products")
}

// ── Negocios / Catálogo ──────────────────────────────────

model Business {
  id                             String         @id @default(cuid())
  name                           String
  phone                          String
  address                        String
  joinedAt                       DateTime       @default(now())
  active                         Boolean        @default(true)
  // active = el negocio pertenece a Tráelo. acceptingOrders = puede recibir pedidos ahora mismo
  // (independiente de active). El horario/BusinessClosure determina además si está abierto.
  acceptingOrders                Boolean        @default(true)
  commissionType                 CommissionType
  commissionPercentage           Decimal?       @db.Decimal(5, 2)
  defaultProductCommissionAmount Decimal?       @db.Decimal(10, 2)
  // Tarifa base de mensajería para pedidos creados desde la app (CUP). Default 250; los
  // negocios con mensajería más cara (ej. DLM, Ella y Yo, La Lomita, Los Reales, Las
  // Palmitas) se configuran en 350 desde el dashboard. El cálculo final (recargo nocturno,
  // recargo por negocio extra en pedidos multi-negocio) vive en
  // orders/delivery-fee-calculator.ts, no acá — esto es solo la tarifa base por negocio.
  deliveryFeeBase                Decimal        @default(250) @db.Decimal(10, 2)
  // Fase 22: mismo criterio que Product.imageUrl — solo la URL, versionada al servirla.
  logoUrl                        String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  products            Product[]
  productCommissions  BusinessProductCommission[]
  subscriptions       BusinessSubscription[]
  orderBusinesses     OrderBusiness[]
  businessSettlements BusinessSettlement[]
  businessHours       BusinessHours[]
  closures            BusinessClosure[]
  favoritedBy         CustomerFavoriteBusiness[]

  @@index([active, acceptingOrders])
  @@map("businesses")
}

// Preparado para el flujo de liquidación a negocios. Todavía sin service/rutas:
// solo el modelo, listo para cuando se implemente el pago a negocios.
model BusinessSettlement {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  periodStart DateTime
  periodEnd   DateTime

  orderCount        Int     @default(0)
  grossSales        Decimal @default(0) @db.Decimal(12, 2) // ventas del negocio (subtotal), 100% suyo
  platformFeeEarned Decimal @default(0) @db.Decimal(12, 2) // Servicio Tráelo generado por este negocio

  status BusinessSettlementStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, periodStart, periodEnd])
  @@index([businessId, status])
  @@map("business_settlements")
}

model BusinessSubscription {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycle      SubscriptionCycle
  price      Decimal            @db.Decimal(10, 2)
  startDate  DateTime
  endDate    DateTime
  status     SubscriptionStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())

  @@index([businessId, status])
  @@map("business_subscriptions")
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Legacy: string libre, se mantiene por compatibilidad con productos existentes.
  // Nueva navegación estructurada vía categoryId/categoryRef (ver Category). No se elimina
  // todavía: primero hay que poblar Category y hacer el backfill de categoryId.
  category    String?
  categoryId  String?
  price       Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  // active = pertenece al catálogo. available = tiene stock/está ofreciéndose ahora mismo.
  // active=true + available=false = "existe en el catálogo pero está agotado".
  available   Boolean  @default(true)
  // Independiente de available: el producto SÍ se puede comprar, pero se le avisa al cliente
  // que queda poco (para que no se lleve una sorpresa si se agota antes de que le respondan
  // el pedido). No reemplaza available — cuando de verdad se agota, available pasa a false.
  lowStock    Boolean  @default(false)
  externalId  String?
  // Fase 22 del checklist de la app: solo la URL, nunca el binario. Quien la aloja es
  // responsable de que sea cacheable agresivamente; el catálogo la sirve con un query param
  // de versión (?v=updatedAt) para que un cambio de imagen invalide el cache del móvil sin
  // depender de que la URL en sí cambie.
  imageUrl    String?
  // Opciones de empaque/envase entre las que el cliente elige al comprar (ej. Termopack, Caja,
  // Jaba): [{ name, price, capacity? }]. null = el producto no lleva empaque. `price` es el costo
  // del empaque en CUP; `capacity`, si existe, son las unidades que caben en un empaque (sin ella
  // se cobra un empaque por unidad). Se valida con packagingSchema (businesses/packaging.ts).
  packaging   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Nombrado categoryRef (no category) porque el campo legacy `category` ya ocupa ese
  // nombre. Cuando se retire el string legacy, este relation field puede renombrarse a
  // `category` sin tocar la columna categoryId (los relation fields no son columnas).
  categoryRef Category?                  @relation(fields: [categoryId], references: [id])
  commission  BusinessProductCommission?
  orderItems  OrderItem[]
  offers      ProductOffer[]
  favoritedBy CustomerFavoriteProduct[]

  @@unique([businessId, externalId])
  @@index([businessId, active, available])
  @@index([categoryId])
  @@map("products")
}

model BusinessProductCommission {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  commissionAmount Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("business_product_commissions")
}

// Categoría global de catálogo (no pertenece a un negocio en particular). Navegación y
// búsqueda de la app. Ver comentario en Product.category sobre la estrategia de transición
// desde el string legacy.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// Precio promocional temporal. NO reemplaza Product.price (precio normal/referencial):
// el precio efectivo de un pedido siempre queda congelado en OrderItem.unitPrice al momento
// de la compra. El cálculo de qué precio aplicar (normal vs. oferta vigente) es lógica de
// aplicación, fuera del alcance de esta tarea.
model ProductOffer {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([active, startsAt, endsAt])
  @@map("product_offers")
}

// Horario habitual semanal. Un cierre puntual (ej. mantenimiento de un día) se resuelve con
// BusinessClosure, no modificando este horario. Un solo turno por día (sin franjas partidas)
// — suficiente para el alcance actual, evita sobreingeniería.
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = domingo … 6 = sábado (convención JS Date#getDay())
  openTime   DateTime @db.Time()
  closeTime  DateTime @db.Time()
  closed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("business_hours")
}

// Cierre excepcional de un día puntual (mantenimiento, feriado, etc.) sin tocar el horario
// habitual en BusinessHours.
model BusinessClosure {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, date])
  @@index([businessId])
  @@map("business_closures")
}

// ── Pedidos ──────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  orderNumber      Int         @unique @default(autoincrement())
  customerName     String
  customerAddress  String
  addressReference String?
  customerPhone    String
  deliveryFee      Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  // Todos los pedidos existentes fueron registrados manualmente por el equipo desde el
  // dashboard — MANUAL preserva exactamente ese comportamiento histórico.
  source           OrderSource @default(MANUAL)
  orderDate        DateTime    @default(now())
  assignedAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  // Cliente de la app/web, si el pedido está vinculado a uno. Nullable: hay pedidos
  // manuales sin Customer y seguirá habiendo (empleado ↔ cliente desconocido/no registrado).
  // customerName/customerPhone/customerAddress/addressReference arriba son el snapshot
  // histórico del pedido y NUNCA cambian si el Customer edita sus datos después.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Idempotencia (Fase 13 del checklist de la app): la app manda un id generado en el
  // cliente por intento de checkout. Si la misma request llega dos veces (mala conexión,
  // timeout, doble tap), la segunda encuentra este unique y devuelve el pedido ya creado en
  // vez de duplicarlo. Nullable/único: los pedidos manuales del dashboard nunca lo usan.
  clientRequestId String? @unique

  delivererId String?
  deliverer   Deliverer? @relation("OrderDeliverer", fields: [delivererId], references: [id])

  // Nullable: un pedido creado por un Customer desde la app no tiene un User de staff detrás
  // (customerId = X, registeredByUserId = null). Los pedidos manuales del dashboard lo siguen
  // llenando siempre — ese flujo no cambia.
  registeredByUserId String?
  registeredBy       User?   @relation("OrderRegisteredBy", fields: [registeredByUserId], references: [id])

  productsTotal Decimal @db.Decimal(10, 2) // subtotal de productos — 100% del negocio, nunca se toca
  platformFee   Decimal @default(0) @db.Decimal(10, 2) // "Servicio Tráelo": suma de comisiones por negocio, redondeada hacia arriba al múltiplo de 10. 0 en pedidos previos a este cambio (nunca tuvieron un cargo separado).
  total         Decimal @db.Decimal(10, 2) // productsTotal + deliveryFee + platformFee

  // Número del "🎟️ Número del Sorteo" del vale, cuando el pedido participa de una promoción
  // vigente. Opcional: no todos los pedidos ni todas las épocas tienen sorteo activo.
  raffleNumber Int?

  traeloEarning       Decimal @db.Decimal(10, 2) // ganancia total de Tráelo = platformFee + traeloDeliveryShare
  delivererEarning    Decimal @db.Decimal(10, 2)
  traeloDeliveryShare Decimal @default(0) @db.Decimal(10, 2) // parte de Tráelo en la mensajería (deliveryFee - delivererEarning)

  businesses      OrderBusiness[]
  settlementLines SettlementOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderDate])
  @@index([delivererId])
  @@index([customerId])
  @@map("orders")
}

model OrderBusiness {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessId       String
  business         Business @relation(fields: [businessId], references: [id])
  subtotal         Decimal  @db.Decimal(10, 2)
  commissionEarned Decimal  @db.Decimal(10, 2) // sin redondear — el detalle real generado por este negocio

  // Snapshots: si el negocio se renombra o cambia su modelo/porcentaje de comisión después,
  // este pedido histórico no debe cambiar. Nullable porque los pedidos creados antes de este
  // cambio nunca capturaron esta información (no se inventa un valor histórico falso).
  businessNameSnapshot   String?
  commissionTypeSnapshot CommissionType?
  commissionRateSnapshot Decimal?        @db.Decimal(5, 2) // solo aplica cuando commissionTypeSnapshot = PERCENTAGE

  items OrderItem[]

  @@unique([orderId, businessId])
  @@index([businessId])
  @@map("order_businesses")
}

model OrderItem {
  id               String        @id @default(cuid())
  orderBusinessId  String
  orderBusiness    OrderBusiness @relation(fields: [orderBusinessId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id])
  productName      String
  quantity         Int           @default(1)
  unitPrice        Decimal       @db.Decimal(10, 2)
  subtotal         Decimal       @db.Decimal(10, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)

  @@index([productId])
  @@map("order_items")
}

// ── Cuadres ──────────────────────────────────────────────

model Settlement {
  id          String           @id @default(cuid())
  type        SettlementType
  delivererId String
  deliverer   Deliverer        @relation(fields: [delivererId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      SettlementStatus @default(OPEN)

  totalDeliveries      Int     @default(0)
  totalCollected       Decimal @default(0) @db.Decimal(10, 2)
  traeloDeliveryShare  Decimal @default(0) @db.Decimal(10, 2) // parte de Tráelo en la mensajería (antes "traeloShare")
  delivererShare       Decimal @default(0) @db.Decimal(10, 2)
  platformFeeCollected Decimal @default(0) @db.Decimal(10, 2) // Servicio Tráelo cobrado por contraentrega (antes "productCommissions")
  totalToDeliver       Decimal @default(0) @db.Decimal(10, 2)

  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?     @relation("SettlementClosedBy", fields: [closedByUserId], references: [id])

  orderLines SettlementOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([delivererId, type, periodStart, periodEnd])
  @@index([status])
  @@map("settlements")
}

model SettlementOrderLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])

  @@unique([settlementId, orderId])
  @@map("settlement_order_lines")
}

// ── Config global ────────────────────────────────────────

model SystemConfig {
  id                                   String   @id @default("singleton")
  defaultDelivererCommissionPercentage Decimal  @default(60) @db.Decimal(5, 2)

  // Bloque promocional opcional que se agrega al final del vale generado (p.ej. campaña de
  // sorteo). rafflePromoText vacío/null = no agregar nada al vale, sin necesidad de un flag
  // "activo" aparte.
  rafflePromoText String?
  raffleVideoUrl  String?

  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// Contador global del catálogo (fila única, mismo patrón que SystemConfig). La app móvil
// hace GET del valor actual al abrir y lo compara con el que tiene cacheado localmente para
// decidir si necesita sincronizar. La capa de servicio (fuera de esta tarea) es responsable
// de incrementarlo cada vez que cambie Business/Product/Category/precio/disponibilidad/
// horario/oferta/estado operativo.
model CatalogState {
  id        String   @id @default("singleton")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("catalog_state")
}

// Log mínimo para "GET changes since version X": una fila por entidad de catálogo que
// cambió, con la versión de CatalogState vigente en ese momento. La app pide
// WHERE version > X ORDER BY version y vuelve a pedir esas entidades por su endpoint normal
// — este log no duplica los datos de la entidad, solo señala qué cambió.
model CatalogChangeLog {
  id         String            @id @default(cuid())
  version    Int
  entityType CatalogEntityType
  entityId   String
  changeType CatalogChangeType @default(UPSERT)
  createdAt  DateTime          @default(now())

  @@index([version])
  @@index([entityType, entityId])
  @@map("catalog_change_log")
}
